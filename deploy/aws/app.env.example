# Copy to app.env (same folder) and fill in. Never commit app.env.

# Gemini (Google AI) – key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database: leave empty to use SQLite on the instance's disk (simplest).
# RDS PostgreSQL:           DATABASE_URL=postgresql://sfadmin:<password>@<rds-endpoint>:5432/smartfactory
# RDS SQL Server Express:   DATABASE_URL=mssql+pymssql://sfadmin:<password>@<rds-endpoint>:1433/smartfactory
DATABASE_URL=

# Optional
INTEGRATION_API_KEY=
LOG_LEVEL=INFO
