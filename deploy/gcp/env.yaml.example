# Cloud Run environment variables (used with: --env-vars-file deploy/gcp/env.yaml)
# Copy to env.yaml and fill in. Keep the quotes. Never commit env.yaml.

# Gemini API key (free) from https://aistudio.google.com/apikey
GEMINI_API_KEY: "PASTE_YOUR_GEMINI_KEY"
GEMINI_MODEL: "gemini-2.5-flash"

# Free PostgreSQL from https://neon.com (Dashboard -> Connect -> connection string)
DATABASE_URL: "postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Keep trained models, uploads and photos in the database (Cloud Run's disk is temporary)
STORAGE_BACKEND: "db"

# Only if the website is hosted on ANOTHER address (e.g. Firebase Hosting). Comma-separated, no trailing slash.
# CORS_ORIGINS: "https://YOUR-PROJECT.web.app,https://YOUR-PROJECT.firebaseapp.com"

LOG_LEVEL: "INFO"
