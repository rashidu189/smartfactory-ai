# ---------- Gemini ----------
# Option A (recommended on Google Cloud): Gemini on Vertex AI, no key needed
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Option B: Gemini API key from Google AI Studio (leave Vertex vars empty)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- SQL Server ----------
# Local / any SQL Server you manage with SSMS:
# DATABASE_URL=mssql+pymssql://sfapp:YourPassword@localhost:1433/smartfactory
# Cloud SQL for SQL Server (used on Cloud Run):
# CLOUD_SQL_INSTANCE=your-project-id:us-central1:smartfactory-sql
# DB_USER=sfapp
# DB_PASS=...            # use Secret Manager in production
# DB_NAME=smartfactory
# (nothing set -> local SQLite file, for quick development only)

# ---------- File storage ----------
# GCS_BUCKET=your-project-id-smartfactory   # empty -> local folder

# ---------- Integrations (IoT / ERP / Pub/Sub) ----------
# Optional bootstrap key accepted by /api/integrations/* (API keys can also be created in the UI)
# INTEGRATION_API_KEY=
# Required to enable the Pub/Sub push endpoint (/api/integrations/pubsub/push?token=...)
# PUBSUB_VERIFICATION_TOKEN=
